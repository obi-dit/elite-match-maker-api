// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          Int      @id @default(autoincrement())
  fullName                    String?
  firstName                   String?   // For membership users
  lastName                    String?   // For membership users
  age                         Int?      // Made optional for membership users
  email                       String?   @unique
  password                    String?
  whatsappNumber              String?
  gender                      GENDER?
  cityOfResidence             City?
  cityOther                   String?  // Only if cityOfResidence == OTHER
  englishProficiency          EnglishProficiency?
  heightCm                    Int?      // Made optional for membership users
  weightKg                    Int?      // Made optional for membership users
  isSingleAndAvailable        Boolean?
  comfortableFilming          Boolean?
  traditionalWantsMarriage    Boolean?
  willingToCompete            Boolean?
  children                    Children?
  willingLieDetector          Boolean?
  consentForMedia             Boolean?
  personalityThreeWords       String?
  relationshipGoals           String?
  attractionToOlderMen        String?
  whyGoodWife                 String?
  talentsOrHobbies            String?
  comfortableBikiniChallenges Boolean?  @default(false)
  photo1                      String?   // store file path or URL
  photo2                      String?
  photo3                      String?
  isApplicantApproved         Boolean @default(false)
  introVideo                  String?   // store file path or URL
  socialMediaLinks            String?  // comma-separated or JSON string
  isMembershipSubscribed      Boolean  @default(false)
  understandsPrivateShow      Boolean? @default(true)
  understandsNoCompensation   Boolean? @default(true)
  confirmsTruthful            Boolean? @default(true)
  selectedTier                String?   // For membership users
  role                        UserRole @default(USER)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  // Relationships
  userPackages                UserPackage[]
  transactions                Transaction[]
  userSubscription            UserSubscription[]
  podcastAccess               PodcastAccess[]

  likesAsClient              Likes[] @relation("ClientLikes")
  likesAsApplicant           Likes[] @relation("ApplicantLikes")
}

model Package {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  price       Decimal
  stripePriceId String? // Stripe Price ID
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  userPackages UserPackage[]
  transactions Transaction[]
}

model Transaction {
  id              Int       @id @default(autoincrement())
  userId          Int
  packageId       Int?
  subscriptionId  Int?
  stripePaymentIntentId String? // Stripe Payment Intent ID
  stripeCheckoutSessionId String? // Stripe Checkout Session ID
  amount          Decimal
  currency        String    @default("USD")
  status          TransactionStatus @default(PENDING)
  paymentMethod   String?
  metadata        Json? // Additional payment metadata
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relationships
  user            User      @relation(fields: [userId], references: [id])
  package         Package?  @relation(fields: [packageId], references: [id])
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  transactionAddOns TransactionAddOn[]

  @@index([userId])
  @@index([stripePaymentIntentId])
  @@index([stripeCheckoutSessionId])
}

model UserPackage {
  id        Int      @id @default(autoincrement())
  userId    Int
  packageId Int
  purchasedAt DateTime @default(now())
  expiresAt DateTime?
  isActive  Boolean  @default(true)
 
  userPackageAddOn UserPackageAddOn[]
  // Relationships
  user      User     @relation(fields: [userId], references: [id])
  package   Package  @relation(fields: [packageId], references: [id])

  @@unique([userId, packageId])
  @@index([userId])
  @@index([packageId])
}

model AddOn {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  price       Decimal?
  isCustomPricing Boolean @default(false)
  customPricingNote String?
  isActive    Boolean  @default(true)
  category    AddOnCategory @default(SERVICE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  userPackageAddOn UserPackageAddOn[]
  transactionAddOns TransactionAddOn[]
}

model UserPackageAddOn {
  id        Int      @id @default(autoincrement())
  userPackageId    Int
  addOnId   Int
  quantity  Int      @default(1)
  customPrice Decimal? // For custom pricing
  notes     String?  // Additional notes
  purchasedAt DateTime @default(now())
  isActive  Boolean  @default(true)

  // Relationships
  userPackage      UserPackage     @relation(fields: [userPackageId], references: [id])
  addOn     AddOn    @relation(fields: [addOnId], references: [id])

  @@index([userPackageId])
  @@index([addOnId])
}

model TransactionAddOn {
  id            Int       @id @default(autoincrement())
  transactionId Int
  addOnId       Int
  quantity      Int       @default(1)
  unitPrice    Decimal   // Price at time of purchase
  totalPrice   Decimal   // quantity * unitPrice
  
  // Relationships
  transaction  Transaction @relation(fields: [transactionId], references: [id])
  addOn        AddOn      @relation(fields: [addOnId], references: [id])
  
  @@index([transactionId])
  @@index([addOnId])
}

model Subscription {
  id                  Int       @id @default(autoincrement())
  tier                TierEnum    @unique // bronze, silver, gold, elite-vip
  price               Decimal
  period              SupscriptionPeriod  @default(MONTHLY)
  isActive            Boolean   @default(false)
  currency            String    @default("USD")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  // Relationships
  transaction         Transaction[]
  subscriptionFeatures SubscriptionFeature[]
  userSubscription     UserSubscription[]
}


model Likes {
  id           Int    @id @default(autoincrement())
  clientId     Int
  applicantId  Int
  client       User    @relation("ClientLikes", fields: [clientId], references: [id])
  applicant    User    @relation("ApplicantLikes", fields: [applicantId], references: [id])

  @@unique([clientId, applicantId])
  @@index([clientId])
  @@index([applicantId])
}

model UserSubscription {
  id                  Int       @id @default(autoincrement())
  userId              Int  
  subscriptionId      Int
  stripeCustomerId    String    // Stripe Customer ID
  stripeSubscriptionId String?  // Stripe Subscription ID
  status              SubscriptionStatus @default(ACTIVE)
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  price               Decimal
  currency            String    @default("USD")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relationships
  user                User            @relation(fields: [userId], references: [id])
  subscription        Subscription    @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  
  @@index([subscriptionId])
}
model Feature {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  category    FeatureCategory @default(CONTENT)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  subscriptionFeatures SubscriptionFeature[]

  @@index([category])
}


model SubscriptionFeature {
  id             Int       @id @default(autoincrement())
  subscriptionId Int
  featureId      Int
  createdAt      DateTime  @default(now())
  // Relationships
  subscription  Subscription @relation(fields: [subscriptionId], references: [id])
  feature       Feature      @relation(fields: [featureId], references: [id])

  @@unique([subscriptionId, featureId])
  @@index([subscriptionId])
  @@index([featureId])


}

enum City {
  BARRANQUILLA
  SANTA_MARTA
  CARTAGENA
  MEDELLIN
  BOGOTA
  NEW_YORK
  LOS_ANGELES
  CHICAGO
  HOUSTON
  PHOENIX
  PHILADELPHIA
  SAN_ANTONIO
  SAN_DIEGO
  DALLAS
  SAN_JOSE
  OTHER
}

enum EnglishProficiency {
  YES
  SOMEWHAT
  NO
}

enum Children {
  NO
  YES_1
  YES_2_PLUS
}

enum GENDER {
  MALE
  FEMALE
}

enum TransactionStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum AddOnCategory {
  SERVICE
  VERIFICATION
  MEDIA
  CONCIERGE
  OTHER
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  UNPAID
  TRIAL
}

enum FeatureCategory {
  CONTENT
  COMMUNITY
  INTERACTION
  MATCHMAKING
  CONCIERGE
  VERIFICATION
  MEDIA
  OTHER
}


enum TierEnum {
  BRONZE 
  SILVER 
  GOLD 
  ELITEVIP
}


enum SupscriptionPeriod{
  MONTHLY
  WEEKLY
  DAILY
  YEARLY
}

model Podcast {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  audioUrl    String?  // URL to audio file
  videoUrl    String?  // URL to video file (for live streams)
  thumbnailUrl String? // URL to thumbnail image
  duration    Int?     // Duration in seconds
  status      PodcastStatus @default(DRAFT)
  type        PodcastType @default(RECORDED)
  scheduledAt DateTime? // For live podcasts
  streamKey   String?   // For live streaming
  isLive      Boolean   @default(false)
  viewCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relationships
  podcastAccess PodcastAccess[]
  podcastCategories PodcastCategory[]

  @@index([status])
  @@index([type])
  @@index([isLive])
  @@index([scheduledAt])
}

model PodcastCategory {
  id        Int      @id @default(autoincrement())
  podcastId Int
  category  String   // e.g., "Dating Tips", "Success Stories", "Live Q&A"
  createdAt DateTime @default(now())

  // Relationships
  podcast   Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([podcastId, category])
  @@index([podcastId])
  @@index([category])
}

model PodcastAccess {
  id        Int      @id @default(autoincrement())
  podcastId Int
  userId    Int
  accessedAt DateTime @default(now())

  // Relationships
  podcast   Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([podcastId, userId])
  @@index([podcastId])
  @@index([userId])
}

enum PodcastStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  LIVE
  ENDED
}

enum PodcastType {
  RECORDED
  LIVE
  PREMIUM
}

enum UserRole {
  USER
  ADMIN
}